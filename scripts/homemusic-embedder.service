[Unit]
Description=HomeMusic Embedder Vector Service (Local / CPU)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/HomeMusic-public/embedder
Environment=DATA_DIR=/root/HomeMusic-public/embedder/data
Environment=MODELS_DIR=/root/HomeMusic-public/embedder/models
Environment=MUSIC_ROOT=/opt/music/library
Environment=EMBEDDER_MODEL=muq-mulan
Environment=EMBEDDER_DEVICE=cpu
Environment=EMBEDDER_DISABLE_WORKER=1
ExecStart=/opt/embedder_venv/bin/uvicorn app.main:create_app --factory --host 0.0.0.0 --port 8090 --no-access-log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
